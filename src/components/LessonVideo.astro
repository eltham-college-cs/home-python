---
// A video slot: <LessonVideo clip="predictRun" />. Reads the lesson's `videos`
// frontmatter, or finds a file named by the convention in docs/VIDEOS.md.
// Empty slots show a placeholder in development and are hidden in production.
// (The spec calls this prop `slot`, but Astro reserves that name.)
import { resolveVideo } from '../lib/videos';

interface Props {
  clip: string;
  title?: string;
}
const { clip, title } = Astro.props;
const lesson = Astro.locals.lesson;
if (!lesson) throw new Error('LessonVideo must be used inside a lesson');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const v = resolveVideo(lesson.year, lesson.lesson, clip, lesson.videos[clip], base);
const labels: Record<string, string> = {
  bigIdea: 'Watch: the big idea',
  predictRun: 'Watch: predict, then run',
  fixBug: 'Watch: fixing the bug',
};
const label = title ?? labels[clip] ?? 'Watch the video';
const dev = import.meta.env.DEV;
---

{
  v.kind === 'file' && (
    <figure class="video">
      <figcaption>{label}</figcaption>
      <video controls preload="none" poster={v.poster} playsinline>
        <source src={v.src} type="video/mp4" />
        {v.captions && <track kind="captions" src={v.captions} srclang="en" label="English" default />}
      </video>
    </figure>
  )
}
{
  v.kind === 'youtube' && (
    <figure class="video">
      <figcaption>{label}</figcaption>
      <div class="yt" data-yt={v.id}>
        <button type="button" class="yt-play">
          <span class="yt-icon" aria-hidden="true">▶</span>
          <span>Play video</span>
          <span class="yt-note">Loads from YouTube when you press play</span>
        </button>
      </div>
    </figure>
  )
}
{
  v.kind === 'empty' && dev && (
    <figure class="video video-empty">
      <figcaption>{label}</figcaption>
      <div class="video-soon">
        <span class="soon-title">Video coming soon</span>
        <span class="soon-file">
          Drop <code>{v.expected}</code> in place. This box only shows in development.
        </span>
      </div>
    </figure>
  )
}

<style is:global>
  .video {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 760px;
  }
  .video figcaption {
    font-weight: 600;
    color: var(--navy);
    font-size: 17px;
  }
  .video video,
  .yt {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    background: var(--navy);
  }
  .yt iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius-sm);
  }
  .yt-play {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--navy);
    color: #fff;
    font-family: var(--font-body);
    font-size: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
  }
  .yt-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
  }
  .yt-note {
    font-size: 14px;
    color: #c9d6e4;
  }
  .video-soon {
    min-height: 110px;
    border: 3px dashed #9cc4ec;
    border-radius: var(--radius-sm);
    background: repeating-linear-gradient(-45deg, #f4f8fc, #f4f8fc 12px, #eaf2fb 12px, #eaf2fb 24px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 16px;
    text-align: center;
  }
  .soon-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    color: var(--navy);
  }
  .soon-file {
    font-size: 15px;
    color: var(--muted);
  }
  .soon-file code {
    white-space: normal !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('button')!.addEventListener('click', () => {
      const id = encodeURIComponent(box.dataset.yt!);
      box.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Lesson video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
