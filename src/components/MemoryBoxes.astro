---
// Variables as labelled boxes, or a list as numbered boxes.
interface Props {
  /** Variables: name and value. */
  boxes?: { name: string; value: string }[];
  /** A list: its name and items (as you would write them in Python). */
  list?: { name: string; items: string[] };
  caption?: string;
}
const { boxes, list, caption } = Astro.props;
const isText = (v: string) => /^["']/.test(v);
---

<figure class="memory">
  {
    boxes && (
      <div class="mem-row">
        {boxes.map((b) => (
          <div class="mem-box">
            <div class:list={['mem-value', { text: isText(b.value) }]}>{b.value}</div>
            <div class="mem-label">{b.name}</div>
          </div>
        ))}
      </div>
    )
  }
  {
    list && (
      <div class="mem-list">
        <div class="mem-list-name">
          <code>{list.name}</code> =
        </div>
        <ol class="mem-row" start="0">
          {list.items.map((v, i) => (
            <li class="mem-box">
              <div class:list={['mem-value', { text: isText(v) }]}>{v}</div>
              <div class="mem-index">
                index <strong>{i}</strong>
              </div>
            </li>
          ))}
        </ol>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .memory {
    margin: 0;
    background: var(--panel);
    border-radius: var(--radius-sm);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  [data-year='8'] .memory {
    border: 1px solid var(--border);
  }
  .mem-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mem-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 96px;
  }
  .mem-value {
    font-family: var(--font-code);
    font-size: 20px;
    font-weight: 500;
    background: #fff;
    border: 3px solid var(--navy);
    border-radius: 12px;
    padding: 14px 16px;
    min-width: 96px;
    text-align: center;
    color: #1f6b45;
  }
  .mem-value.text {
    color: #7a5300;
  }
  .mem-label {
    font-family: var(--font-code);
    font-size: 16px;
    background: var(--gold);
    color: var(--navy);
    border-radius: 8px;
    padding: 2px 10px;
    font-weight: 500;
  }
  .mem-index {
    font-size: 15px;
    color: var(--muted);
  }
  .mem-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .mem-list-name {
    font-size: 20px;
  }
  .memory figcaption {
    font-size: 16px;
    color: var(--muted);
  }
</style>
